# Cobaltz Dark for Rex
# Cobaltz tuned for Rex's derived window chrome.
# Rex derives the sidebar from the background and draws it a step
# darker than the panes, so the background sits a step above the
# Cobaltz page blue (#0F2438) to keep the sidebar a distinct blue.

# Base colors (lifted Cobaltz navy, softened white)
background = #182E44
foreground = #E7EEF5

# Cursor (also Rex's accent: shell icons and focus, Cobaltz green)
cursor-color = #70D149
cursor-text = #0F2438

# Selection (cobalt, white text at 4.5:1)
selection-background = #3478C6
selection-foreground = #FFFFFF

# ANSI Colors (0-7: normal, 8-15: bright)
# Black (Cobaltz sidebar blue, one step above the page)
palette = 0=#20354A
palette = 8=#5C7A99

# Red
palette = 1=#EA4025
palette = 9=#ED7482

# Green
palette = 2=#70D149
palette = 10=#6FD640

# Yellow
palette = 3=#ECD146
palette = 11=#F8D949

# Blue
palette = 4=#3B86F7
palette = 12=#82AAFF

# Magenta
palette = 5=#EE7FF8
palette = 13=#ED99FA

# Cyan
palette = 6=#95E5F8
palette = 14=#95E5F8

# White
palette = 7=#F7F7F7
palette = 15=#FFFFFF
