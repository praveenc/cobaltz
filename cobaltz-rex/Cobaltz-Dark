# Cobaltz Dark for Rex
# Cobaltz tuned for Rex's derived window chrome.
# Rex draws the sidebar a step darker than the background, so the
# background is lifted until the sidebar lands on the Cobaltz
# sidebar blue (#20354A).

# Base colors (lifted Cobaltz navy, softened white)
background = #223951
foreground = #E7EEF5

# Cursor (also Rex's accent: shell icons and focus, Cobaltz green)
cursor-color = #70D149
cursor-text = #0F2438

# Selection (cobalt, white text at 4.5:1)
selection-background = #3478C6
selection-foreground = #FFFFFF

# ANSI Colors (0-7: normal, 8-15: bright)
# Black (Cobaltz page blue, darker than the lifted background)
palette = 0=#0F2438
palette = 8=#7A95AD

# Red
palette = 1=#EA4025
palette = 9=#ED7482

# Green
palette = 2=#70D149
palette = 10=#6FD640

# Yellow
palette = 3=#ECD146
palette = 11=#F8D949

# Blue
palette = 4=#3B86F7
palette = 12=#82AAFF

# Magenta
palette = 5=#EE7FF8
palette = 13=#ED99FA

# Cyan
palette = 6=#95E5F8
palette = 14=#95E5F8

# White
palette = 7=#F7F7F7
palette = 15=#FFFFFF
